/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aqi-backend",
	"main": "src/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{ "pattern": "aqi-backend.murali.page", "custom_domain": true },
		{ "pattern": "aqi-backend.orangeiqlabs.com/*", "zone_name": "orangeiqlabs.com" }
	],
	"compatibility_date": "2025-09-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aqi_db",
			"database_id": "87882461-63d2-49c0-bb40-bbae12ea3ec8",
			"remote": true
		}
	],
	"durable_objects": { "bindings": [{ "name": "AQI_SESSION", "class_name": "AqiSession" }] },
	"migrations": [{ "tag": "aqi-session-v1", "new_sqlite_classes": ["AqiSession"] }],
	"send_email": [{
		"name": "AQI_ALERT_EMAIL",
		"allowed_destination_addresses": ["muralidharan@gmail.com"],
		"allowed_sender_addresses": ["alerts@calorie-alerts.muralidharan.fyi"]
	}],
	"vars": {
		"AQI_ALERT_FROM": "alerts@calorie-alerts.muralidharan.fyi",
		"AQI_ALERT_TO": "muralidharan@gmail.com",
		"AQI_LOGIN_EMAIL": "muralidharan@gmail.com",
		"WINIX_MONITOR_DEVICE_ID": "murali-living-room",
		"WINIX_TARGET_DEVICE_IDS": "",
		"WINIX_CONTROL_ENABLED": "true",
		"WINIX_DEADBAND_UGM3": "2",
		"WINIX_MIN_DWELL_MINUTES": "10",
		"WINIX_MIN_SAMPLES_5M": "3",
		"WINIX_MAX_SAMPLE_AGE_SECONDS": "360",
		"WINIX_DRY_RUN": "false"
	},
	"triggers": {
		"crons": ["*/5 * * * *", "* * * * *"]
	}
}
